---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { postUrl } from '../../lib/postUrl';

const rawPosts = await getCollection('blog');
const posts = rawPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmtDate = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });

// Group posts by year for a magazine-style index.
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<Base
  title="Writing — Aakash Sethi | Founder of Tnufa AI"
  description="Technical writing on AI engineering, agentic systems, AWS, fintech, and building a consulting practice."
>
  <div class="blog-shell">
    <header class="blog-hero">
      <p class="blog-eyebrow">Writing · Mylogs</p>
      <h1 class="blog-h1">Ideas I keep shipping back to.</h1>
      <p class="blog-lede">AI engineering, agentic systems, AWS architecture, fintech, and building a consulting practice. Updated as I ship.</p>
      <p class="blog-meta">{posts.length} pieces</p>
    </header>

    {years.map(year => (
      <section class="blog-year">
        <h2 class="year-marker">{year}</h2>
        <ol class="blog-list">
          {byYear.get(year)!.map(post => {
            const cat = post.data.categories?.[0];
            return (
              <li class="post-row">
                <a class="post-link" href={postUrl(post)}>
                  <p class="post-kicker">
                    {cat && <span class="post-cat">{cat}</span>}
                    {cat && <span class="post-dot">·</span>}
                    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                  </p>
                  <h3 class="post-title">{post.data.title}</h3>
                  {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
                  <span class="post-more">Read →</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style is:global>
  .blog-shell {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px clamp(20px, 5vw, 32px) 120px;
  }

  .blog-hero { margin-bottom: 72px; }
  .blog-eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-500); margin: 0 0 20px;
  }
  .blog-h1 {
    font-family: var(--font-editorial); font-optical-sizing: auto;
    font-weight: 500; font-size: clamp(40px, 6vw, 60px); line-height: 1.02;
    letter-spacing: -0.035em; margin: 0 0 20px; color: var(--ink-950);
  }
  .blog-lede {
    font-family: var(--font-editorial); font-optical-sizing: auto;
    font-style: italic; font-weight: 400;
    font-size: 20px; line-height: 1.5; color: var(--ink-700);
    margin: 0 0 20px; max-width: 60ch;
  }
  .blog-meta {
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-400);
    letter-spacing: 0.08em; text-transform: uppercase; margin: 0;
  }

  .blog-year { margin: 56px 0 0; }
  .year-marker {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-400); margin: 0 0 20px;
    padding-bottom: 12px; border-bottom: 1px solid var(--ink-100);
  }

  .blog-list { list-style: none; padding: 0; margin: 0; }
  .post-row { border-bottom: 1px solid var(--ink-100); }
  .post-row:last-child { border-bottom: none; }
  .post-link {
    display: block;
    padding: 32px 0;
    text-decoration: none; color: inherit;
    transition: opacity 150ms;
  }
  .post-link:hover { opacity: 1; }
  .post-link:hover .post-title { color: var(--signal-700); }

  .post-kicker {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-500); margin: 0 0 12px;
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  }
  .post-cat { color: var(--signal-700); }
  .post-dot { color: var(--ink-300); }
  .post-kicker time { color: var(--ink-500); }

  .post-title {
    font-family: var(--font-editorial); font-optical-sizing: auto;
    font-weight: 500; font-size: 28px; line-height: 1.2;
    letter-spacing: -0.02em; color: var(--ink-950);
    margin: 0 0 14px;
    transition: color 150ms;
  }

  .post-excerpt {
    font-family: var(--font-reading), var(--font-editorial), Georgia, serif;
    font-size: 17px; line-height: 1.6; color: var(--ink-700);
    margin: 0 0 14px;
    max-width: 62ch;
  }

  .post-more {
    display: inline-block;
    font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-400);
    transition: color 150ms, transform 150ms;
  }
  .post-link:hover .post-more { color: var(--signal-700); transform: translateX(2px); }

  @media (max-width: 720px) {
    .blog-shell { padding-top: 56px; }
    .blog-hero { margin-bottom: 48px; }
    .post-title { font-size: 24px; }
    .post-excerpt { font-size: 16px; }
  }
</style>
