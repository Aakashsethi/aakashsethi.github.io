---
import Base from '../../layouts/Base.astro';

// Wireframe for the CashNews iOS companion app. Editorial layout —
// hero screen (Feed) up top, three-across trio below, then a "where
// it's live" section that embeds the actual YouTube uploads playlist
// so visitors can watch the same daily drop the app plays.
//
// SwiftUI source at ios/CashNewsPreview/ mirrors this hierarchy.

// Channel ID from data/site_config.json — uploads playlist is
// UU + channel_id[2:] (i.e. UC → UU).
const CHANNEL_ID = 'UCVdpOAxaSsi19DsGCsjr35w';
const UPLOADS_PLAYLIST = `UU${CHANNEL_ID.slice(2)}`;
const CHANNEL_URL = 'https://www.youtube.com/@AakashSethi007';

// Feed items — 4 mock daily drops
const feedItems = [
  { date: 'Aug 25', title: 'Fed signals cut', tag: 'MACRO', duration: '1:42' },
  { date: 'Aug 24', title: 'NVIDIA earnings beat', tag: 'AI', duration: '2:04' },
  { date: 'Aug 23', title: 'OpenAI ship day', tag: 'AI', duration: '1:58' },
  { date: 'Aug 22', title: 'Housing starts drop', tag: 'MACRO', duration: '1:37' },
];

const transcript = [
  { t: '00:00', text: 'The Fed just gave us the clearest signal yet.' },
  { t: '00:07', text: 'Rate cuts back on the table for September.' },
  { t: '00:14', text: 'Markets priced in three cuts by year-end.' },
  { t: '00:22', text: 'Here\'s the twist nobody\'s talking about.' },
];

const summary = [
  'Fed minutes hint at a September rate cut — first since 2023.',
  'CPI came in at 2.3%, below the 2.5% consensus.',
  'Bond yields dropped 12bps on the news; equities rallied.',
  '"The disinflation trend is now durable." — Fed Chair Powell.',
];

const smallScreens = [
  { id: 'player', title: 'Player', caption: 'Portrait video with a tap-to-jump transcript.' },
  { id: 'summary', title: 'Summary', caption: 'Bulleted brief for readers who\'d rather skim.' },
  { id: 'settings', title: 'Settings', caption: 'Sources, notification cadence, avatar voice.' },
];
---
<Base
  title="CashNews iOS · Preview — Aakash Sethi"
  description="SwiftUI wireframe for the CashNews iOS companion app, alongside the live daily drops streaming on YouTube."
>
  <div class="cn-shell">
    <!-- Hero -->
    <header class="cn-hero">
      <p class="cn-eyebrow">Wireframe · CashNews for iOS</p>
      <h1 class="cn-title">A companion app for a channel that runs itself.</h1>
      <p class="cn-lede">
        Native SwiftUI. Reads the same signed <code>drops.json</code> the automated pipeline
        publishes at broadcast time — so the app is always one refresh behind the video.
      </p>
      <p class="cn-meta">
        <span>Swift 5.9</span>
        <span class="cn-sep">/</span>
        <span>SwiftUI</span>
        <span class="cn-sep">/</span>
        <span>iOS 17+</span>
        <span class="cn-sep">/</span>
        <a href="https://github.com/Aakashsethi/CashNewsIOS" target="_blank" rel="noreferrer">GitHub repo →</a>
      </p>
    </header>

    <!-- Hero Feed screen -->
    <section class="cn-hero-screen">
      <div class="cn-hero-frame-wrap">
        <div class="iphone-frame">
          <div class="iphone-notch" aria-hidden="true"></div>
          <div class="iphone-screen">
            <div class="ios-status-bar">
              <span>9:41</span>
              <span class="ios-status-icons" aria-hidden="true"></span>
            </div>
            <div class="app feed">
              <div class="app-nav">
                <h2>Today</h2>
                <button aria-label="Settings" class="app-nav-btn">⚙︎</button>
              </div>
              <div class="feed-hero">
                <div class="feed-hero-thumb">
                  <span class="feed-hero-play">▶</span>
                  <span class="feed-hero-badge">LIVE · 2 hrs ago</span>
                </div>
                <p class="feed-hero-title">Fed signals cut, markets rally</p>
                <p class="feed-hero-meta">2:04 · 3 stories</p>
              </div>
              <p class="feed-section">Recent drops</p>
              {feedItems.map(f => (
                <div class="feed-row">
                  <div class="feed-row-thumb"><span>▶</span></div>
                  <div class="feed-row-body">
                    <p class="feed-row-title">{f.title}</p>
                    <p class="feed-row-meta"><span class="tag">{f.tag}</span> {f.date} · {f.duration}</p>
                  </div>
                </div>
              ))}
            </div>
            <div class="ios-home-indicator" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <div class="cn-hero-caption">
        <p class="cn-screen-number">01</p>
        <h2 class="cn-screen-title">The feed.</h2>
        <p class="cn-screen-copy">
          The app opens on today's drop — always. Cover fills the frame; the older week lives
          beneath it as a lightweight list. Nothing to configure, nothing to swipe past.
        </p>
      </div>
    </section>

    <!-- Trio of smaller screens -->
    <section class="cn-trio">
      {smallScreens.map((s, idx) => (
        <figure class="cn-screen">
          <div class="iphone-frame">
            <div class="iphone-notch" aria-hidden="true"></div>
            <div class="iphone-screen">
              <div class="ios-status-bar">
                <span>9:41</span>
                <span class="ios-status-icons" aria-hidden="true"></span>
              </div>

              {s.id === 'player' && (
                <div class="app player">
                  <div class="app-nav">
                    <button aria-label="Back" class="app-nav-btn">←</button>
                    <button aria-label="Share" class="app-nav-btn">↗</button>
                  </div>
                  <div class="player-video">
                    <div class="player-avatar" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="60" height="60" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 21a8 8 0 0 1 16 0"/>
                      </svg>
                    </div>
                    <div class="player-controls">
                      <div class="player-progress"><div class="player-progress-bar"></div></div>
                      <div class="player-time"><span>0:47</span><span>2:04</span></div>
                    </div>
                  </div>
                  <p class="player-title">Fed signals cut, markets rally</p>
                  <p class="player-transcript-header">Transcript</p>
                  <ol class="player-transcript">
                    {transcript.map((t, i) => (
                      <li class={i === 1 ? 'is-active' : ''}>
                        <span class="tx-time">{t.t}</span>
                        <span class="tx-text">{t.text}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {s.id === 'summary' && (
                <div class="app summary">
                  <div class="app-nav">
                    <button aria-label="Back" class="app-nav-btn">←</button>
                    <button aria-label="Share" class="app-nav-btn">↗</button>
                  </div>
                  <p class="summary-eyebrow">Aug 25 · Daily brief</p>
                  <h3 class="summary-title">Fed signals cut, markets rally</h3>
                  <ul class="summary-list">
                    {summary.map(s => <li>{s}</li>)}
                  </ul>
                  <div class="summary-cta">
                    <button class="summary-btn primary">Read full source</button>
                    <button class="summary-btn ghost">Save for later</button>
                  </div>
                </div>
              )}

              {s.id === 'settings' && (
                <div class="app settings">
                  <div class="app-nav">
                    <h2>Settings</h2>
                    <button aria-label="Close" class="app-nav-btn">✕</button>
                  </div>
                  <p class="settings-section">Sources</p>
                  <div class="settings-row"><span>Bloomberg</span><span class="toggle on"></span></div>
                  <div class="settings-row"><span>Reuters</span><span class="toggle on"></span></div>
                  <div class="settings-row"><span>WSJ</span><span class="toggle off"></span></div>
                  <p class="settings-section">Notifications</p>
                  <div class="settings-row"><span>Daily drop</span><span class="settings-value">9:00 AM ET</span></div>
                  <div class="settings-row"><span>Breaking only</span><span class="toggle off"></span></div>
                  <p class="settings-section">Avatar voice</p>
                  <div class="settings-row"><span>ElevenLabs · Rachel</span><span class="settings-chevron">›</span></div>
                </div>
              )}

              <div class="ios-home-indicator" aria-hidden="true"></div>
            </div>
          </div>
          <figcaption>
            <p class="cn-screen-number">{String(idx + 2).padStart(2, '0')}</p>
            <p class="cn-screen-title-sm">{s.title}</p>
            <p class="cn-screen-copy-sm">{s.caption}</p>
          </figcaption>
        </figure>
      ))}
    </section>

    <!-- Where it's deployed — YouTube shorts -->
    <section class="cn-deploy">
      <div class="cn-deploy-head">
        <p class="cn-eyebrow">Where it's live</p>
        <h2 class="cn-h2">The channel the app plays.</h2>
        <p class="cn-copy">
          The pipeline publishes to
          <a href={CHANNEL_URL} target="_blank" rel="noreferrer">YouTube</a> as short-form
          video, then syndicates the same cut to Instagram Reels and TikTok. The iOS app
          reads a signed CDN JSON published at the same time, so the app is always in sync
          with the video.
        </p>
      </div>

      <div class="cn-youtube-wrap">
        <div class="cn-youtube-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/videoseries?list=${UPLOADS_PLAYLIST}&modestbranding=1&rel=0`}
            title="CashNews — latest daily drops"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p class="cn-youtube-caption mono">
          Latest daily drops · updated at publish time · <a href={CHANNEL_URL} target="_blank" rel="noreferrer">Open channel →</a>
        </p>
      </div>

      <div class="cn-platforms">
        <a class="cn-platform" href={CHANNEL_URL} target="_blank" rel="noreferrer">
          <span class="cn-platform-name">YouTube</span>
          <span class="cn-platform-handle">@AakashSethi007</span>
        </a>
        <a class="cn-platform" href="https://www.instagram.com/aakashsethi007/" target="_blank" rel="noreferrer">
          <span class="cn-platform-name">Instagram</span>
          <span class="cn-platform-handle">@aakashsethi007</span>
        </a>
        <a class="cn-platform" href="https://www.tiktok.com/@aakashsethi007" target="_blank" rel="noreferrer">
          <span class="cn-platform-name">TikTok</span>
          <span class="cn-platform-handle">@aakashsethi007</span>
        </a>
      </div>
    </section>

    <!-- Implementation notes -->
    <section class="cn-notes">
      <h2 class="cn-h2">Under the hood.</h2>
      <ul class="cn-notes-list">
        <li><b>Feed backend:</b> the app pulls a signed CDN JSON (<code>drops.json</code>) generated by the CashNews pipeline at publish time. No per-user round-trips.</li>
        <li><b>Player:</b> <code>AVPlayerViewController</code> in portrait; transcript is a sibling JSON with word-level timestamps.</li>
        <li><b>Summary:</b> served alongside the transcript. Full-source link opens Safari — no in-app browser to maintain.</li>
        <li><b>Settings:</b> <code>@AppStorage</code> for source toggles and cadence; voice picker reads a signed list from the same pipeline.</li>
        <li><b>Design:</b> SF Pro system fonts, warm-neutral palette matching the site.</li>
      </ul>
    </section>

    <p class="cn-back">
      <a href="/">← Back to home</a>
    </p>
  </div>
</Base>

<style is:global>
  .cn-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 88px clamp(20px, 5vw, 40px) 128px;
  }

  /* Hero copy */
  .cn-hero { max-width: 720px; margin-bottom: 72px; }
  .cn-eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-500); margin: 0 0 20px;
  }
  .cn-title {
    font-family: var(--font-editorial); font-optical-sizing: auto;
    font-weight: 500; font-size: clamp(38px, 5.5vw, 60px); line-height: 1.02;
    letter-spacing: -0.035em; color: var(--ink-950); margin: 0 0 22px;
  }
  .cn-lede {
    font-family: var(--font-editorial); font-style: italic;
    font-size: 21px; line-height: 1.48; color: var(--ink-700);
    margin: 0 0 22px; max-width: 62ch; font-weight: 400;
  }
  .cn-lede code {
    font-family: var(--font-mono); font-size: 0.9em; font-style: normal;
    color: var(--ink-800); background: var(--ink-100);
    padding: 2px 6px; border-radius: 4px;
  }
  .cn-meta {
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-500);
    letter-spacing: 0.06em; display: flex; flex-wrap: wrap; gap: 10px;
    align-items: center; margin: 0;
  }
  .cn-meta a { color: var(--signal-700); text-decoration: none; }
  .cn-meta a:hover { text-decoration: underline; }
  .cn-sep { color: var(--ink-300); }

  /* Hero screen — Feed */
  .cn-hero-screen {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
    padding: 56px 0;
    margin: 0 0 40px;
    border-top: 1px solid var(--ink-100);
    border-bottom: 1px solid var(--ink-100);
  }
  .cn-hero-frame-wrap { display: flex; justify-content: center; }
  .cn-hero-caption { max-width: 480px; }
  .cn-screen-number {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    color: var(--ink-400); margin: 0 0 12px;
  }
  .cn-screen-title {
    font-family: var(--font-editorial); font-optical-sizing: auto;
    font-weight: 500; font-size: 34px; line-height: 1.1;
    letter-spacing: -0.025em; color: var(--ink-950); margin: 0 0 16px;
  }
  .cn-screen-copy {
    font-family: var(--font-reading), var(--font-editorial), Georgia, serif;
    font-size: 17px; line-height: 1.6; color: var(--ink-700);
    margin: 0; max-width: 52ch;
  }

  /* Trio grid */
  .cn-trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
    margin: 0 0 96px;
  }
  .cn-screen { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .cn-screen figcaption {
    margin-top: 24px; text-align: center; max-width: 280px;
  }
  .cn-screen-title-sm {
    font-family: var(--font-editorial); font-weight: 500;
    font-size: 20px; letter-spacing: -0.02em; color: var(--ink-950);
    margin: 8px 0 6px;
  }
  .cn-screen-copy-sm {
    font-family: var(--font-reading), Georgia, serif;
    font-size: 14px; line-height: 1.55; color: var(--ink-500); margin: 0;
  }

  @media (max-width: 900px) {
    .cn-hero-screen { grid-template-columns: 1fr; }
    .cn-trio { grid-template-columns: 1fr; gap: 48px; }
  }

  /* iPhone frame */
  .iphone-frame {
    width: 280px; height: 574px;
    background: #1c1917;
    border-radius: 44px;
    padding: 8px;
    box-shadow:
      0 30px 60px -20px rgba(28,25,23,0.25),
      0 8px 20px -8px rgba(28,25,23,0.15),
      inset 0 0 0 1px rgba(255,255,255,0.05);
    position: relative;
  }
  .iphone-notch {
    position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    width: 88px; height: 22px;
    background: #1c1917;
    border-radius: 12px;
    z-index: 3;
  }
  .iphone-screen {
    width: 100%; height: 100%;
    background: #ffffff;
    border-radius: 36px;
    overflow: hidden;
    position: relative;
    display: flex; flex-direction: column;
  }
  .ios-status-bar {
    padding: 14px 24px 4px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif;
    font-size: 12px; font-weight: 600; color: #1c1917;
  }
  .ios-status-icons {
    width: 40px; height: 12px;
    background:
      radial-gradient(circle 2px at 4px 6px, #1c1917 100%, transparent 0),
      radial-gradient(circle 2px at 12px 6px, #1c1917 100%, transparent 0),
      radial-gradient(circle 2px at 20px 6px, #1c1917 100%, transparent 0);
    background-repeat: no-repeat;
  }
  .ios-home-indicator {
    position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
    width: 108px; height: 4px; border-radius: 2px;
    background: #1c1917; opacity: 0.7;
  }

  /* App content */
  .app {
    flex: 1; padding: 10px 18px 28px; overflow-y: auto;
    font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif;
    color: #1c1917;
  }
  .app::-webkit-scrollbar { display: none; }
  .app-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin: 6px 0 14px;
  }
  .app-nav h2 {
    font-family: -apple-system, 'SF Pro Display', sans-serif;
    font-size: 22px; font-weight: 700; margin: 0; letter-spacing: -0.025em;
  }
  .app-nav-btn {
    background: transparent; border: 0; font-size: 16px; color: #1c1917;
    cursor: pointer; padding: 4px 6px;
  }

  /* Feed */
  .feed-hero {
    background: #1c1917; border-radius: 16px; padding: 12px;
    margin-bottom: 20px;
  }
  .feed-hero-thumb {
    height: 148px; border-radius: 10px;
    background: linear-gradient(135deg, #44403b 0%, #1c1917 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .feed-hero-play { font-size: 32px; color: #fafaf9; }
  .feed-hero-badge {
    position: absolute; top: 10px; left: 10px;
    background: rgba(250,250,249,0.14); color: #fafaf9;
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 9px; letter-spacing: 0.1em; padding: 4px 7px; border-radius: 4px;
    font-weight: 500;
  }
  .feed-hero-title { color: #fafaf9; font-size: 16px; font-weight: 600; margin: 12px 0 3px; letter-spacing: -0.015em; }
  .feed-hero-meta { color: #d6d3d1; font-size: 11px; margin: 0; }
  .feed-section {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em;
    color: #78716c; text-transform: uppercase; margin: 14px 0 10px;
  }
  .feed-row {
    display: flex; gap: 12px; align-items: center; padding: 10px 0;
    border-bottom: 1px solid #f5f5f4;
  }
  .feed-row:last-child { border-bottom: 0; }
  .feed-row-thumb {
    width: 46px; height: 46px; border-radius: 10px;
    background: #e7e5e4; color: #57534d;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .feed-row-body { flex: 1; min-width: 0; }
  .feed-row-title { font-size: 14px; font-weight: 500; margin: 0 0 3px; letter-spacing: -0.01em; }
  .feed-row-meta { font-size: 11px; color: #78716c; margin: 0; display: flex; gap: 8px; align-items: center; }
  .tag {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 9px; letter-spacing: 0.1em; font-weight: 500;
    color: #78716c; background: #f5f5f4;
    padding: 2px 6px; border-radius: 4px;
  }

  /* Player */
  .player-video {
    background: #1c1917; border-radius: 14px; height: 240px;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 14px; margin-bottom: 16px;
  }
  .player-avatar {
    flex: 1; display: flex; align-items: center; justify-content: center;
    color: #78716c;
  }
  .player-controls { color: #fafaf9; }
  .player-progress {
    height: 3px; background: rgba(250,250,249,0.2); border-radius: 2px;
    overflow: hidden; margin-bottom: 8px;
  }
  .player-progress-bar { height: 100%; width: 38%; background: #fafaf9; border-radius: 2px; }
  .player-time {
    display: flex; justify-content: space-between;
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px;
  }
  .player-title { font-size: 15px; font-weight: 600; margin: 0 0 14px; letter-spacing: -0.015em; }
  .player-transcript-header {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em;
    color: #78716c; text-transform: uppercase; margin: 0 0 8px;
  }
  .player-transcript { list-style: none; padding: 0; margin: 0; }
  .player-transcript li {
    display: flex; gap: 10px; padding: 8px 0;
    font-size: 12px; line-height: 1.45; color: #78716c;
    border-bottom: 1px solid #f5f5f4;
  }
  .player-transcript li:last-child { border-bottom: 0; }
  .player-transcript li.is-active { color: #1c1917; font-weight: 500; }
  .tx-time {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px; color: #a6a09b;
    min-width: 34px;
  }

  /* Summary */
  .summary-eyebrow {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em;
    color: #78716c; text-transform: uppercase; margin: 4px 0 10px;
  }
  .summary-title {
    font-family: -apple-system, 'SF Pro Display', sans-serif;
    font-size: 21px; font-weight: 600; letter-spacing: -0.025em;
    margin: 0 0 16px; line-height: 1.15;
  }
  .summary-list { padding: 0; margin: 0 0 18px; list-style: none; }
  .summary-list li {
    font-size: 13px; line-height: 1.5; color: #44403b;
    padding: 10px 0 10px 16px; position: relative;
    border-top: 1px solid #f5f5f4;
  }
  .summary-list li:first-child { border-top: 0; }
  .summary-list li::before {
    content: ''; position: absolute; left: 0; top: 17px;
    width: 5px; height: 5px; border-radius: 50%; background: #78716c;
  }
  .summary-cta { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .summary-btn {
    padding: 12px; border-radius: 12px; border: 0;
    font-family: -apple-system, 'SF Pro Text', sans-serif;
    font-size: 13px; font-weight: 600; cursor: pointer;
  }
  .summary-btn.primary { background: #1c1917; color: #fafaf9; }
  .summary-btn.ghost { background: transparent; color: #1c1917; border: 1px solid #d6d3d1; }

  /* Settings */
  .settings-section {
    font-family: -apple-system, 'SF Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em;
    color: #78716c; text-transform: uppercase; margin: 16px 0 8px;
  }
  .settings-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 0; border-bottom: 1px solid #f5f5f4;
    font-size: 13px;
  }
  .settings-row:last-child { border-bottom: 0; }
  .settings-value {
